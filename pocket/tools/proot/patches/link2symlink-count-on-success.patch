 /**
+ * Remember the faked hard link that the rename(2) or unlink(2) being
+ * processed removes or replaces, to count it down once the call
+ * succeeds (see handle_sysexit_end): not before, as a call can fail,
+ * and on Android be blocked: its seccomp filter blocks rename(2) and
+ * unlink(2) on x86-64, and PRoot runs them again as renameat(2) and
+ * unlinkat(2), so the entry is seen twice.  Counting at the entry
+ * counted such a link down twice, and with two links left deleted
+ * the file the other one still named.
+ */
+static int remember_count_down(Extension *extension, Reg sysarg)
+{
+	Tracee *tracee = TRACEE(extension);
+	Link2SymlinkConfig *config = get_config(extension, true);
+	int status;
+
+	if (config == NULL)
+		return -ENOMEM;
+
+	config->pending_count_down[0] = '\0';
+	status = find_intermediate(tracee, sysarg, config->pending_count_down);
+	if (status <= 0)
+		config->pending_count_down[0] = '\0';
+
+	return status < 0 ? status : 0;
+}
