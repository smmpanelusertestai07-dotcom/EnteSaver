<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark as a vector, on the 108 dp adaptive canvas Android's own splash expects.

    It exists because the launcher foreground ships only as PNGs, and the Android 12+ splash
    needs a vector for windowSplashScreenAnimatedIcon. The geometry is the same one
    plan/make_icon.py draws the PNGs from, at the same 0.40 fill, so the thing on the splash and
    the thing on the home screen are the same size and shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="root"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:name="mark" android:pivotX="54" android:pivotY="54">
