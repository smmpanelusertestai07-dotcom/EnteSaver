.godot/
build/
*.apk
*.aab
*.jks
*.keystore
export_credentials.cfg
.import/
# Private reference screenshots of other games (analysis only, never committed).
reference_private/
# Written by tools/build_apk.sh (and the CI export) for one build: the signing certificate
# hashes and the save-signing secret. Never commit.
build_keys.gd
build_keys.gd.uid
# Older builds wrote these plain files; keep them out of commits too.
build_signer.txt
build_secret.txt
__pycache__/
# Scratch renders of the props pipeline
tools/props/_render_tmp/
# Preview renders and work files of the asset tools (under tools/, never shipped); older
# versions of the tools wrote their previews into assets/
tools/props/previews/
tools/character/previews/
tools/media/_work/
assets/props/previews/
assets/character/previews/
# Character pipeline intermediates and scratch renders (tools/character/*.py)
tools/character/work/
tools/character/scratch/
*.log
# No documents in the repository (Ente Saver's tests fail on any tracked .md): the .md files
# Claude Code reads are links made by tools/agents/install.sh to the .txt sources there.
*.md
